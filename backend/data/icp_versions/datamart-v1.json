  "personas": [
    {
      "key": "scaling_cto",
      "name": "The Scaling CTO",
      "titles": ["CTO", "Chief Technology Officer", "VP Engineering", "VP of Engineering", "Head of Engineering", "Co-Founder & CTO", "Engineering Manager", "Director of Engineering"],
      "company_profile": "SaaS, FinTech, or HealthTech; 10-40 employees; $1M-$10M revenue; 3-8 person engineering team.",
      "triggers": ["Senior role open for 90+ days", "Developer lost mid-sprint", "Large-customer feature deadline"],
      "resonates": ["Technical assessments", "Code review examples", "Named senior talent and start date", "Concrete SLA language"],
      "repels": ["Vague timelines", "Full-service agency claims", "Feature dumping", "Meeting a PM before the engineer"]
    },
    {
      "key": "nontechnical_founder",
      "name": "The Non-Technical Founder",
      "titles": ["Founder", "CEO", "Co-Founder", "Managing Director"],
      "company_profile": "Pre- or early-revenue; 1-10 employees; Angel/Seed funded or bootstrapped from industry revenue.",
      "triggers": ["Funding received", "Failed freelancer or agency engagement", "No-code limitations", "Investor or pilot deadline"],
      "resonates": ["Relevant MVP case studies", "Clear v1 versus v2 scope", "Plain-language product strategy", "Budget transparency"],
      "repels": ["Technical posturing", "Long proposals without clear price", "Requests for technical specifications"]
    },
    {
      "key": "operations_owner",
      "name": "The Operations Owner",
      "titles": ["Owner", "Managing Director", "Practice Manager", "Operations Director", "IT Director", "General Manager", "Partner", "Principal"],
      "company_profile": "Established small business; 10-50 employees; $1M-$10M revenue; healthcare, real estate, finance, or e-commerce.",
      "triggers": ["Compliance warning", "Key spreadsheet owner resigned", "Client lost to a digital competitor", "Staff turnover from manual processes"],
      "resonates": ["Plain-language ROI", "Hours saved per week", "Compliance outcomes", "Ongoing maintenance"],
      "repels": ["Jargon", "Unpredictable hourly billing", "Being asked to manage developers"]
    }
  ],
  "tiers": [
    {"key": "tier_1", "name": "Tier 1", "revenue_min": 1000000, "revenue_max": 10000000, "employees_min": 10, "employees_max": 50, "description": "Primary target: post-PMF, actively scaling, high retainer likelihood."},
