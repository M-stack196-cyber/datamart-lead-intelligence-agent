# Frontend development configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend development configuration
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

VIBE_API_KEY=
# AgentSource API base URL. Do not place your API key in source control.
VIBE_API_BASE_URL=https://api.explorium.ai
# The worker never spends a credit unless this is explicitly set to true.
VIBE_ENRICHMENT_ENABLED=false
VIBE_WORKER_NAME=local-vibe-worker
# Explicit maximum number of credits/jobs allowed in one worker invocation.
VIBE_APPROVED_JOB_LIMIT=1

AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
