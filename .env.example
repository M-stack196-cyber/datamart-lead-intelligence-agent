# Frontend development configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend development configuration
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

VIBE_API_KEY=
# Copy the exact AgentSource enrichment endpoint from your Vibe/Explorium account.
# The worker never calls Vibe unless this URL and VIBE_ENRICHMENT_ENABLED=true are set.
VIBE_ENRICHMENT_URL=
VIBE_ENRICHMENT_ENABLED=false
VIBE_WORKER_NAME=local-vibe-worker

AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
